{
  "name": "@propsphere/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint . --ext ts --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/throttler": "^6.1.0",
    "@propsphere/config": "workspace:*",
    "@propsphere/types": "workspace:*",
    "@supabase/supabase-js": "^2.43.0",
    "bullmq": "^5.76.6",
    "firebase-admin": "^13.9.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "*"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@propsphere/types$": "<rootDir>/../../packages/types/src",
      "^@propsphere/config$": "<rootDir>/../../packages/config/src",
      "^@propsphere/utils$": "<rootDir>/../../packages/utils/src"
    }
  }
}
